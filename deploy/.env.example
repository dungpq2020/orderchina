# Copy to .env (cùng thư mục deploy/) rồi điền giá trị thật trước khi chạy docker compose up.
# KHÔNG commit file .env vào git.

POSTGRES_DB=orderchina
POSTGRES_USER=orderchina
POSTGRES_PASSWORD=change-me-strong-password

JWT_ISSUER=orderchina-ng

# Khóa RSA private (PKCS#1 traditional) ký JWT RS256, encode base64 — KHÔNG dùng HMAC secret thường.
# Tạo mới bằng (bắt buộc có -traditional, OpenSSL 3.x mặc định xuất PKCS#8 khiến .NET không import được):
#   openssl genrsa 2048 | openssl rsa -traditional -outform DER | base64 -w0
JWT_RSA_PRIVATE_KEY_BASE64=

# Tài khoản Staff đầu tiên (chỉ seed 1 lần khi bảng Users còn trống) — để trống thì Migrator bỏ qua seed.
# Login dùng Username + mật khẩu; Email chỉ để liên hệ.
SEED_ADMIN_USERNAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

ASPNETCORE_ENVIRONMENT=Production
