{
  "manifest_version": 3,
  "name": "OrderChina - Thêm vào giỏ",
  "version": "0.1.0",
  "description": "Thêm sản phẩm từ Taobao/Tmall/1688 vào giỏ hàng OrderChina ngay trên trang chi tiết sản phẩm.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "OrderChina",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://nhaphangtrungquoc.sdnagency.com/*",
    "http://localhost:5199/*",
    "https://item.taobao.com/*",
    "https://*.taobao.com/*",
    "https://detail.tmall.com/*",
    "https://*.tmall.com/*",
    "https://detail.1688.com/*",
    "https://*.1688.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://item.taobao.com/*",
        "https://*.taobao.com/item.htm*",
        "https://detail.tmall.com/*",
        "https://*.tmall.com/item.htm*"
      ],
      "js": ["config.js", "content-common.js", "content-taobao.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://detail.1688.com/*", "https://*.1688.com/offer/*"],
      "js": ["config.js", "content-common.js", "content-1688.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
